# ai-browser local deployment environment

AI_BROWSER_HOST=127.0.0.1
AI_BROWSER_PORT=8888
AI_BROWSER_PATH=/usr/bin/google-chrome
AI_BROWSER_HEADLESS=false
AI_BROWSER_ENGINE=auto
AI_BROWSER_WIDTH=1280
AI_BROWSER_HEIGHT=800

# Native OS fallback needs X11. Adjust for each machine.
DISPLAY=:1
XAUTHORITY=/run/user/1000/gdm/Xauthority

